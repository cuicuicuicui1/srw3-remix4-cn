      "notes": [
        {
          "id": "08-8166-8174",
          "kind": "term",
          "note": "「オープン・ゲット」按盖塔合体口令处理，译为“开启·合体”。"
        },
        {
          "id": "08-8177-8183",
          "kind": "term",
          "note": "同 08-8166-8174，「オープン・ゲット」译为“开启·合体”。"
        },
        {
          "id": "08-8AAB-8AB9",
          "kind": "typo",
          "note": "原文「昭準」按上下文应为「照準」，译为“瞄准设定”。"
        },
        {
          "id": "08-8BAE-8BB6",
          "kind": "ambiguity",
          "note": "「やるかよ」可作正面“干就干”或反面“想得美”，本批按正面语气译为“干就干”。见 questions.json。"
        },
        {
          "id": "08-8C16-8C25",
          "kind": "ambiguity",
          "note": "「かとんぼ」所指对象不明确，暂按“火蜻蜓”处理。见 questions.json。"
        },
        {
          "id": "08-8E4C-8E60",
          "kind": "style",
          "note": "「ラ・・・ラァ・・・」为无实义喊声，译为“啦……啦……”。"
        },
        {
          "id": "08-8F34-8F49",
          "kind": "term",
          "note": "「アカシック・バスター」译为“阿卡夏·破坏炮”。"
        },
        {
          "id": "08-8FE4-9001",
          "kind": "ambiguity",
          "note": "「ラァイ」可能为“雷”或单纯战吼，暂译为“雷”。见 questions.json。"
        },
        {
          "id": "08-9024-9030",
          "kind": "ambiguity",
          "note": "「ラァイ」单条战吼，暂按“雷”处理。见 questions.json。"
        },
        {
          "id": "08-91BD-91D3",
          "kind": "term",
          "note": "「サイ・フラッシュ」按 Psy Flash 译为“精神闪光”。"
        },
        {
          "id": "08-9485-9490",
          "kind": "dialect",
          "note": "「脱出するタイ」的「タイ」为方言/语气强调，未单独译出。见 questions.json。"
        },
        {
          "id": "08-993E-9981",
          "kind": "term",
          "note": "「ガン」按上下文译为“癌”，指地球与宇宙的癌。"
        },
        {
          "id": "08-9E96-9ED6",
          "kind": "format",
          "note": "原文「１８、４」「６９、５」中的逗号为小数点，译为18.4、69.5。"
        },
        {
          "id": "08-A117-A141",
          "kind": "typo",
          "note": "原文「学障」按上下文应为「学校」，译为“学校”。"
        },
        {
          "id": "08-A43B-A454",
          "kind": "typo",
          "note": "原文「大気罠矢入」按上下文应为「大気圏突入」，译为“大气圈突入”。"
        },
        {
          "id": "08-A457-A465",
          "kind": "typo",
          "note": "原文「矢入」按上下文应为「突入」，译为“突入”。"
        },
        {
          "id": "08-AFDE-B018",
          "kind": "format",
          "note": "原文末尾多出一个「」」，译文按正常引号收束，未复制多余符号。"
        },
        {
          "id": "08-B198-B1CC",
          "kind": "ambiguity",
          "note": "「ズメズメ」为不常见拟态/拟声词，暂译为“磨磨蹭蹭的”。见 questions.json。"
        },
        {
          "id": "08-B268-B29B",
          "kind": "fragment",
          "note": "「あなたさえ…」语义中断，按迟疑语气译为“就连你……”，未补全后续内容。"
        }
      ]
    }
  },
  {
    "batch": "zcode-bulk-02",
    "data": {
      "batch_id": "bulk-02",
      "notes": [
        {
          "id": "08-C5F2-C61E",
          "issue": "原文「矢破」应为「突破」，按上下文译作“突破”。"
        },
        {
          "id": "08-CA3A-CA84",
          "issue": "原文「窓威」应为「脅威」，按上下文译作“威胁”。"
        },
        {
          "id": "08-CDBE-CE0D",
          "issue": "原文「人障」应为「人類」或「人間」，按上下文译作“人类”。"
        },
        {
          "id": "08-CF3E-CF87",
          "issue": "原文「もうし開き」应为「申し開き」，译作“交代”。"
        },
        {
          "id": "08-E2BF-E304",
          "issue": "原文「沈脳」应为「洗脳」，译作“洗脑”。"
        },
        {
          "id": "08-E305-E31A",
          "issue": "原文「沈脳」应为「洗脳」，译作“洗脑”。"
        },
        {
          "id": "08-E31B-E359",
          "issue": "原文「なりたくないければ」应为「なりたくなければ」，按“不想变成那样”处理。"
        },
        {
          "id": "08-E50F-E561",
          "issue": "原文「地球罠」应为「地球圏」，译作“地球圈”。"
        },
        {
          "id": "08-FA0B-FA44",
          "issue": "原文「頬得」疑为「得」或「利益」，按“好处”处理。"
        },
        {
          "id": "08-D447-D47A",
          "issue": "原文「ヤケにつかれる」语义含混，结合实验语境按“用起来让人精疲力竭”处理。"
        },
        {
          "id": "08-D5A4-D5DD",
          "issue": "原文「センタク」假名可指「洗濯」或「選択」，按剧情语境取“洗衣服”，存疑。"
        },
        {
          "id": "08-EA76-EA9A",
          "issue": "原文「ふゆかい」应为「不愉快」，译作“不痛快”。"
        },
        {
          "id": "08-FAC3-FB0D",
          "issue": "原文「あつっくるしい」应为「暑っ苦しい」，译作“闷热”。"
        },
        {
          "id": "08-C43E-C45E",
          "issue": "「ロンド」为蕾柯亚的姓（Londe），译作“隆德”，并非隆德贝尔。"
        },
        {
          "id": "08-E3A6-E3DD",
          "issue": "原文「あなたのこと・・・好・・・」在「好」处中断（未写完「好き」），译文保留为「我……喜……」。"
        }
      ]
    }
  },
  {
    "batch": "zcode-bulk-04",
