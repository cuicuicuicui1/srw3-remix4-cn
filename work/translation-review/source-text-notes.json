          "id": "09-BD10-BD26",
          "japanese_fragment": "あったそうそうに",
          "note": "疑为“会ったそうそうに”（刚见面就），按此意译。"
        },
        {
          "id": "09-C01B-C072",
          "japanese_fragment": "失そう事件",
          "note": "原文以平假名书写“失そう”，按“失踪事件”理解。"
        },
        {
          "id": "09-C8E5-C902",
