{
  "source_rom_sha256": "edcffa7b6aa734735b64f7674f02e2cf4e24a7a499cfd24675ad34c86218fe8f",
  "batch_id": "bulk-04",
  "notes": [
    {
      "id": "09-B925-B94B",
      "japanese_fragment": "入浄する",
      "note": "原文“入浄”按上下文应为“入城”，译为“进入冯·布朗市”。"
    },
    {
      "id": "09-BD10-BD26",
      "japanese_fragment": "あったそうそうに",
      "note": "疑为“会ったそうそうに”（刚见面就），按此意译。"
    },
    {
      "id": "09-C01B-C072",
      "japanese_fragment": "失そう事件",
      "note": "原文以平假名书写“失そう”，按“失踪事件”理解。"
    },
    {
      "id": "09-C8E5-C902",
      "japanese_fragment": "矢入する",
      "note": "原文“矢入”按上下文应为“突入”，译为“突入所罗门内部”。"
    },
    {
      "id": "09-C93C-C971",
      "japanese_fragment": "南律５度１５分",
      "note": "“南律”应为“南緯”，译为“南纬5度15分”。"
    },
    {
      "id": "09-DC62-DCA3",
      "japanese_fragment": "アレックスとネモを２体",
      "note": "按“阿雷克斯与尼莫共两台”理解，与后文两名驾驶员相对应。"
    },
    {
      "id": "09-E261-E29D",
      "japanese_fragment": "半抵休息",
      "note": "“半抵”按航海用语疑为“半舷”，译为“半数人员轮休”。"
    },
    {
      "id": "09-E2DC-E2F7",
      "japanese_fragment": "みぎ抵だから",
      "note": "“みぎ抵”按上下文疑为“右舷”，译为“值右舷班”。"
    },
    {
      "id": "09-E5EB-E607",
      "japanese_fragment": "矢然レ－ダ－",
      "note": "“矢然”应为“突然”，译为“雷达突然有反应”。"
    },
    {
      "id": "09-ECCD-ED14",
      "japanese_fragment": "息の圧を止めてやる",
      "note": "“息の圧”按惯用表达应为“息の根”，译为“要了你的命”。"
    },
    {
      "id": "09-F1D3-F224",
      "japanese_fragment": "窓威",
      "note": "“窓威”应为“脅威”，译为“威胁”。"
    }
  ]
}
